"""Regenerate this record console layout inside FreeCAD."""
from pathlib import Path
import runpy
import traceback

layout = Path(__file__).resolve().parent
try:
    builder = runpy.run_path(str(layout.parent / "build_model.py"))
    builder["deliver"](layout.name)
except Exception:
    (layout / "build-error.log").write_text(traceback.format_exc())
    raise
